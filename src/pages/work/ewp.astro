---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/ewp.scss";
import {Image} from "astro:assets";
import bg from "../../assets/images/ewp-bg.svg";
import logo from "../../assets/images/doaj/logo-big.svg"
import arrow from "../../assets/images/arrow.svg"
import triageOrderPhoto from "../../assets/images/doaj/triage-order-photo.png";
import triageRecommendedRejections from "../../assets/images/doaj/recommended-rejection.png";
import triageAppHistory from "../../assets/images/doaj/apphistory.png";
import triageDashboard from "../../assets/images/doaj/dashboard.png";
import triageStatistics from "../../assets/images/doaj/statistics.png";
import triagePrototypes from "../../assets/images/doaj/prototypes.png";
import old from "../../assets/images/doaj/old.png";
import check from "../../assets/images/doaj/check.png";

const project = {
    client: "Directory of Open Access Journals",
    role: "Product designer",
    contributions: [
        "Product discovery",
        "Requirements definition",
        "Workflow and interaction design",
        "UX/UI design",
        "Accessibility",
        "Client facilitation"
    ],
    team: "Cross-functional DOAJ and Cottage Labs team",
    period: "2025 – present",
    status: "Triage design complete · implementation in progress",
};
---

<BaseLayout title="DOAJ Editorial Workflow" bg={bg}>
    <main class="container case-study case-study--ewp" id="main-content">
        <article class="case-study">
            <div class="hero hero--project hero--project--ewp">
                <p class="hero--project__client">
                    <span>{project.client}</span>
                    <img
                            src={logo.src}
                            alt=""
                            class="client-logo"
                    />
                </p>

                <h1 class="hero--project__description easy-read">
                    Making a complex editorial workflow easier to learn and more efficient to
                    complete
                </h1>

                <p class="hero--project__summary easy-read">
                    I am redesigning DOAJ’s editorial workflow: defining how applications move between stages, how
                    reviewers complete and record their work, and how decisions are supported across the process. Triage
                    is the first module I have designed in detail, establishing reusable navigation, interaction and
                    accessibility patterns for the stages that follow.
                </p>

                <dl class="project-meta easy-read">
                    <div>
                        <dt class="sr-only">Roles</dt>
                        <dd class="tag project-meta--role">{project.role}</dd>
                    </div>
                    <div class="project-meta--contributions">
                        <dt class="sr-only">Contributions</dt>
                        {project.contributions.map((contribution) => (
                                <dd class="tag">{contribution}</dd>
                        ))}
                    </div>
                    <div class="project-meta--other">
                        <div class="project-meta--other__item">
                            <dt>Period:</dt>
                            <dd>{project.period}</dd>
                        </div>
                        <div class="project-meta--other__item">
                            <dt>Team:</dt>
                            <dd>{project.team}</dd>
                        </div>
                        <div class="project-meta--other__item">
                            <dt>Status:</dt>
                            <dd>{project.status}</dd>
                        </div>
                    </div>
                </dl>
            </div>

            <section class="case-study__section row">
                <div class="col-lg-7">
                    <h2 class="easy-read">A specialist workflow hidden inside an application form</h2>
                    <p>
                        The Directory of Open Access Journals (DOAJ) evaluates applications from publishers to decide
                        whether journals meet its criteria for inclusion. The process involves DOAJ staff and volunteers
                        with different responsibilities, from the initial Triage through further review to the final
                        decision.
                    </p>

                    <p>
                        The existing system presents reviewers with what is essentially an extended version of the
                        publisher’s application form. It contains the submitted information, but not the editorial work
                        around it: reviewers must know which checks to perform, which external resources to consult and
                        how
                        their findings affect what happens next. Triage has therefore become dependent on one highly
                        experienced specialist, making the work difficult to share and new reviewers difficult to train.
                    </p>

                    <p>
                        DOAJ already had an established visual identity from an earlier service-wide redesign, and a
                        previous UX evaluation had identified problems with the application form. However, the editorial
                        workflow that would address those problems still needed to be designed from the ground up.
                    </p>

                    <p>
                        I had already worked with DOAJ for several years, contributing to smaller improvements across
                        product design, UI and front-end development. The Editorial Workflow Project became a major
                        workstream within that continuing relationship, developed alongside ongoing maintenance and
                        incremental improvements.
                    </p>
                    <p>
                        Working closely with DOAJ’s product and editorial teams, I helped translate their standards and
                        working practices into a coherent workflow. I refined and structured the compliance checks,
                        established the guiding design principles and designed the complete Triage experience—from
                        individual interactions to the overview that records the application’s history.
                    </p>
                </div>

                <figure class="case-study-figure case-study-figure--existing-interface col-lg-5">
                    <div class="image-fade-bottom">
                        <Image src={old} format="webp"
                               alt="The existing DOAJ editorial interface, with administrative controls and application sections stacked in one long, continuous form." "/>
                    </div>
                    <figcaption class="board-note">
                        And it keeps going...
                    </figcaption>
                </figure>

            </section>
            <section class="case-study__section">
                <div class="easy-read">
                    <h2>Defining the workflow, not just the interface</h2>

                    <p>
                        The project’s initial outline placed UX and UI design after requirements definition. I
                        recommended
                        bringing product design in earlier because decisions about how reviewers would move through
                        checks,
                        record their findings and progress an application were themselves part of defining the
                        requirements.
                        Being involved before those requirements were fixed allowed me to help shape the workflow rather
                        than simply translate a completed specification into screens.
                    </p>

                    <p>
                        Before our first face-to-face session, I reviewed the existing documentation and earlier UX
                        findings, then created an initial workflow proposal and presentation for the Editorial Team.
                        This
                        made the proposed structure tangible enough for the team to challenge and annotate. During the
                        session, I revised the design and facilitated a short exercise in which we physically arranged
                        the
                        checks around how the Triage specialist completed the work.
                    </p>
                    <p>
                        The early prototype became a shared requirements tool. Feedback exposed needs that were not yet
                        explicit in the project documentation—for example, recording rejection reasons for reporting,
                        connecting communication with changes of status, and preserving answers and notes across stages.
                        Through weekly meetings, I translated these discussions into revised questions, states,
                        interaction
                        rules and workflows for Triage and the stages that follow.
                    </p>
                </div>

                <figure class="case-study-figure case-study-figure--triage-order">
                    <Image src={triageOrderPhoto} format="webp"
                           alt="Printed Triage questions arranged into groups and sequences across a table, with handwritten notes added during a face-to-face workshop."
                           class="workshop-photo"/>
                    <figcaption class="board-note">
                        Sometimes defining a digital workflow starts with paper strips on a table.
                    </figcaption>
                </figure>
            </section>

            <section class="case-study__section">
                <div class="easy-read">
                    <h2>Defining what “guided by the system” meant</h2>


                    <p>
                        One of the client’s central requirements was that the system should guide editors through each
                        stage. This defined the intended outcome, but not what guidance should look like in practice. I
                        translated the requirement into five principles, then refined them with the client through
                        workshops
                        and weekly discussions.
                    </p>
                </div>

                <ul class="principles row g-4">
                    <li class="principle col-lg-4"><h3>Present one clear step at a time</h3>
                        <p>
                            Break conditional tasks into steps and reveal follow-up fields only when relevant, rather
                            than
                            showing every possible path at once.
                        </p>
                    </li>
                    <li class="principle col-lg-4">
                        <h3>
                            Provide the right context for each task
                        </h3>
                        <p>
                            Place submitted data, instructions and external resources beside each check. Keep the
                            journal
                            title,
                            ISSNs and website visible throughout Triage.
                        </p>
                    </li>
                    <li class="principle col-lg-4">
                        <h3>Keep the expected action one click away</h3>
                        <p>
                            Make the usual next step the easiest action to find and complete, while keeping less common
                            alternatives available.
                        </p>
                    </li>
                    <li class="principle col-lg-4">
                        <h3>Preserve a complete history</h3>
                        <p>
                            Record every answer, note, correction, assignment and communication—including who performed
                            it and when.
                        </p>
                    </li>
                    <li class="principle col-lg-4">
                        <h3>Recommend, but leave the decision with the reviewer</h3>
                        <p>
                            Apply the agreed rules consistently and recommend an outcome, while allowing authorised
                            reviewers to
                            make the final decision.
                        </p>
                    </li>
                </ul>
                <p class="easy-read">
                    Together, these principles gave us a shared reference for resolving edge cases and evaluating new
                    ideas. They also established patterns that could be reused across later stages of the editorial
                    workflow.
                </p>
            </section>

            <section class="case-study__section">
                <div class="easy-read">
                    <h2>One question at a time—with freedom to move</h2>
                </div>

                <figure class="case-study-figure case-study-figure--triage-check">
                    <Image src={check} format="webp"
                           alt="DOAJ Triage design showing an expanded ISSN compliance check with application information, instructions, resources, notes and explicit answer options."
                           />

                    <figcaption class="board-note">
                        One compliance check brings together the information, guidance and
                        actions needed to complete it.
                    </figcaption>
                </figure>

                <div class="easy-read">
                    <p>
                        I designed Triage around one compliance check at a time. Each view brings together the
                        criterion,
                        submitted information, instructions, resources, notes and explicit answer options. Conditional
                        steps
                        appear only when relevant; after a straightforward answer, the next unanswered check opens and
                        focus
                        moves to its heading.
                    </p>
                    <p>
                        This guided structure helps reviewers learn the process, but it initially concerned the
                        experienced
                        Triage specialist. She could complete the familiar workflow in approximately seven minutes and
                        worried that moving through individual questions would introduce unnecessary clicking.
                    </p>

                    <p>
                        During our workshop, she explained that she completes related checks together while particular
                        resources—such as the journal website or ISSN Portal—are open. We used this pattern to group and
                        order the questions. A two-level accordion provides a default sequence while keeping every check
                        directly accessible, and answered checks are skipped automatically.
                    </p>

                    <p>
                        Consistent answer controls combine explicit wording, icons and colour so recurring actions are
                        easy
                        to recognise without relying on colour alone. The prototypes also specify the required heading
                        structure, control semantics, keyboard behaviour and focus movement. The result is a guided path
                        without an inflexible wizard: new reviewers can learn the workflow while experienced reviewers
                        retain direct access.
                    </p>

                    <p>
                        The form itself also provides its navigation through a two-level accordion. Expanding a group
                        reveals its short, meaningful question headings; expanding a question reveals the complete
                        check.
                        Reviewers can
                        reach any check within two interactions, work in a different order and then return to the
                        default
                        sequence. Checks they have already answered are skipped automatically.
                    </p>

                    <p>
                        Answer controls follow a consistent visual and semantic pattern. Compliance, non-compliance,
                        required changes and uncertainty are distinguished through colour, iconography and explicit
                        wording.
                        New
                        reviewers can read the complete answer, while experienced reviewers can recognise recurring
                        actions
                        quickly
                        without relying on colour alone.
                    </p>

                    <p>
                        Accessibility behaviour is part of the design specification. The prototypes define a consistent
                        heading hierarchy, button semantics and expanded states for the accordion headers, native
                        radio-button
                        behaviour with arrow-key navigation, and focus movement to the next question heading. I
                        annotated
                        the required
                        semantic HTML, ARIA attributes and keyboard interactions for developer reference.
                    </p>

                    <p>
                        The result is a guided default path without an inflexible wizard: the system can teach the
                        workflow
                        while preserving direct access for people who already know it.
                    </p>
                </div>
            </section>

            <section class="case-study__section easy-read">
                <h2>Supporting decisions without making them</h2>

                <figure class="case-study-figure case-study-figure--recommended-rejection">
                    <Image src={triageRecommendedRejections} format="webp"
                           alt="Cropped prototype showing the system’s recommendation to reject an
                        application. "/>
                    <figcaption class="board-note">
                        Based on the recorded answers, the system suggests reasons for rejection; the reviewer can
                        choose which reasons to include in the email or add another. An editable text area contains an
                        automatically generated email. The recommended action, “Reject application and email the
                        applicant”, is available directly as a single, primary action. Choosing the secondary
                        alternative requires additional confirmation.
                    </figcaption>
                </figure>

                <p>
                    Completing the checks is only part of Triage. Reviewers must also understand what their answers mean
                    for the application and decide whether to reject it or move it to another stage.
                </p>

                <p>
                    I designed the workflow so that the system interprets the recorded answers and recommends an
                    appropriate outcome. Some non-compliant answers can trigger an immediate rejection recommendation.
                    Others result in rejection only after the complete review, while answers with different severity
                    values contribute
                    to the recommendation for the next stage.
                </p>

                <p>
                    An early version of the requirements assumed that the system would make these decisions
                    automatically. Through discussion, we changed this to a recommendation model: the system applies the
                    agreed rules
                    consistently, but an Editorial reviewer retains authority over the outcome. A reviewer can reject an
                    application at any point, continue after an early rejection recommendation, or override the
                    recommended destination once every check is complete.
                </p>

                <p>
                    This principle also helped us resolve later edge cases. We considered whether the system should
                    prevent progression when every answer was non-compliant. I recommended against introducing a special
                    restriction: blocking one particular combination would immediately raise further questions about
                    where the
                    boundary belonged—for example, whether a single compliant answer should change the result.
                </p>

                <p>
                    Instead, the overview presents every completed check with the same colour, icon and wording used
                    when recording the answer. Unusual patterns remain visible for the Editorial Team to review, while
                    the
                    final decision stays with the authorised user.
                </p>

                <p>
                    When rejection is recommended, the overview presents the suggested outcome alongside editable email
                    content for the publisher. The expected action—sending the email and rejecting the application—is
                    immediately available, while reviewers can still continue the assessment or choose a different
                    outcome.
                </p>

                <p>
                    The result is transparent decision support rather than automated decision-making: the system makes
                    the rules easier to apply without replacing editorial judgement.
                </p>
            </section>
            <section class="case-study__section">
                <div class="easy-read">
                    <h2>Creating one continuous, traceable application record</h2>
                </div>

                <figure class="case-study-figure case-study-figure--application-history">
                    <Image src={triageAppHistory} format="webp"
                           alt="Cropped prototype showing the application history. "/>
                    <figcaption class="board-note">
                        The “New” tab preserves a complete copy of the application as submitted by the publisher.
                        The “Triage” tab records who completed the stage
                        and when, followed by every question and recorded answer. Icons identify the answers,
                        corrections preserve the original and updated values, and automated and reviewer notes appear
                        beneath the relevant questions.
                    </figcaption>
                </figure>

                <div class="easy-read">
                    <p>
                        The principle of preserving a complete history takes shape in the application overview. An
                        editorial
                        review can pass between several people and stages, so decisions cannot remain isolated inside
                        individual forms. I designed the overview as the application’s permanent record and control
                        centre.
                    </p>

                    <p>
                        The history begins with an unchanged copy of the publisher’s submission. Each completed stage
                        then
                        records who completed it and when, every question and answer, question-specific notes, and any
                        corrections—with the original and updated values preserved. Reviewers can understand not only
                        the
                        application’s current state, but how and why it reached it.
                    </p>

                    <p>
                        General notes, assignments and emails sent through the system are also retained on the overview.
                        The
                        available actions respond to the application’s current state: a reviewer might assign it, begin
                        Triage, transfer responsibility, reject it or complete a recommended outcome. Each module can
                        focus
                        on its immediate task while the overview preserves continuity and accountability across the
                        complete
                        process.

                    </p>
                    <p>
                        Although Triage is the first module designed in full, the same structure is intended to connect
                        the
                        five later stages as they are developed and released.
                    </p>
                </div>
            </section>
            <section class="case-study__section">
                <div class="easy-read">
                    <h2>Designing beyond the first release</h2>
                    <p>
                        Focusing the detailed design on Triage kept the first release manageable, but I treated it as
                        one part of a larger editorial process. The shared overview, application history, navigation and
                        interaction patterns establish a foundation for later stages without defining those modules
                        before their requirements are fully understood.
                    </p>
                </div>

                <figure class="case-study-figure case-study-figure--dashboard">
                    <Image src={triageDashboard} format="webp"
                           alt=""/>
                    <figcaption class="board-note">
                        I explored how the dashboard could change to accommodate new workflow.
                        The prototype includes records requiring admin's attention -
                        applications un-claimed or assigned but not started within a defined period, and
                        those started but left unfinished. The dashboard also shows applications the reviewer can
                        resume and new applications they are eligible to review based on their skills and knowledge.
                    </figcaption>
                </figure>

                <div class="easy-read">
                    <p>
                        I also explored two longer-term opportunities created by the new workflow.
                    </p>

                    <h3 class="opportunity-title"><img src={arrow.src} alt="" class="arrow"/>Preserve the history after acceptance</h3>
                    <p>
                        Applications and journals currently remain separate records connected through metadata. I
                        proposed
                        treating an accepted journal as the continuation of its application, allowing administrators to
                        follow its complete history from submission, through review, to inclusion in DOAJ.
                    </p>
                    <h3 class="opportunity-title"><img src={arrow.src} alt="" class="arrow"/>Turn workflow data into operational insight</h3>
                </div>

                <figure class="case-study-figure case-study-figure--statistics">
                    <figcaption class="board-note">
                        Example of operational insight concept (data illustrative).
                    </figcaption>
                    <Image src={triageStatistics} format="webp"
                           alt=""/>
                </figure>

                <div class="easy-read">
                    <p>
                        The redesigned workflow records structured information about stages, assignments and timing. I
                        explored how a future dashboard could use this information to show work moving through each
                        stage,
                        reveal possible bottlenecks and surface records requiring attention—for example, an application
                        that
                        has been assigned but not started, or a Triage review that has remained unfinished.
                    </p>
                    <p>
                        These concepts remain exploratory and outside the first release. They give the wider service a
                        direction while keeping the immediate delivery focused.
                    </p>
                </div>
            </section>
            <section class="case-study__section">
                <div class="easy-read">
                    <h2>Making branching behaviour buildable</h2>
                </div>

                <figure class="case-study-figure case-study-figure--prototypes">
                    <figcaption class="board-note">
                        Example user journeys in Figma
                    </figcaption>
                    <Image src={triagePrototypes} format="webp"
                           alt="Representative prototype journeys captured the critical branches without reproducing every possible combination of application logic."/>
                </figure>

                <div class="easy-read">
                    <p>
                        Triage contains many possible combinations of answers, follow-up fields and outcomes. Creating
                        one
                        exhaustive high-fidelity prototype would have meant reproducing much of the application's logic
                        before development began.
                    </p>
                    <p>
                        Instead, we selected representative scenarios and I created interactive walkthroughs of the most
                        important paths. One scenario, for example, shows a reviewer recording a compliant answer to the
                        first check
                        and a non-compliant answer to the second, receiving an early rejection recommendation, and
                        completing the
                        rejection from the overview page.
                    </p>

                    <p>
                        These scenarios gave the client a concrete way to review and agree the intended behaviour
                        without
                        requiring every possible combination to be prototyped. I also used them when presenting the new
                        design to the
                        wider Editorial Team.
                    </p>

                    <p>
                        My prototypes included detailed annotations covering state changes, semantic structure,
                        accessible
                        labels, keyboard and focus behaviour, and important edge cases. Working with our QA specialist,
                        I translated
                        the agreed behaviour into functional scenarios and acceptance criteria.
                    </p>

                    <p>
                        By working closely with the Editorial Team throughout the project, we arrived at an agreed
                        design
                        that reflects how experienced reviewers work while creating a clearer, more supportive path for
                        people
                        learning the process. The interactive scenarios, annotations and acceptance criteria translate
                        that shared
                        solution into an implementation-ready specification for the development and QA teams.
                    </p>
                </div>
            </section>
        </article>
        <img
                src={bg.src}
                alt=""
                class="background"
        />
    </main>
</BaseLayout>
